# Optional OpenAI-compatible model provider. Leave blank for deterministic fallback.
HAWKEYE_LLM_ENABLED=1
HAWKEYE_LLM_BASE_URL=
HAWKEYE_LLM_API_KEY=
HAWKEYE_LLM_MODEL=
HAWKEYE_LLM_API_STYLE=auto
HAWKEYE_LLM_TIMEOUT_SECONDS=15

# Optional OpenRouter convenience used with compose.openrouter.yaml.
# Keep the real key only in the ignored .env file.
OPENROUTER_APIKEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Optional temporary demo origin. Exact HTTPS browser origin; not authentication.
HAWKEYE_PUBLIC_DEMO_ORIGIN=

# Optional single-operator HTTP Basic gate. Configure both or leave both blank.
HAWKEYE_AUTH_USERNAME=
HAWKEYE_AUTH_PASSWORD=

# Host-side Compose port. Compose still binds it to 127.0.0.1 only.
HAWKEYE_PORT=8760

# Optional host data directory for Compose. The default is ./data.
HAWKEYE_DATA_PATH=./data

# Optional collector-only Proton/OpenVPN sidecar used with compose.vpn.yaml.
# Use the OpenVPN-specific credentials from Proton, not the account password.
# Keep the real values and the .ovpn file outside Git.
PROTON_OPENVPN_USER=
PROTON_OPENVPN_PASSWORD=
PROTON_OPENVPN_CONFIG_PATH=./data/vpn/ca-free-15.protonvpn.udp.ovpn
PROTON_OPENVPN_PORT=51820
GLUETUN_LOG_LEVEL=warning
TZ=Asia/Jakarta
