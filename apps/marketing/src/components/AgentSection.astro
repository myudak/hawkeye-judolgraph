---
import { ArrowRightIcon, CheckIcon, XIcon } from "@phosphor-icons/react";
import { AgentBrowserDemo } from "./AgentBrowserDemo";
const steps = [
  ["Observasi", "Observation"],
  ["Aksi agen", "Agent action"],
  ["Ekstraksi bukti", "Evidence extraction"],
  ["Tinjauan manusia", "Human review"],
  ["Relasi terverifikasi", "Verified relationship"],
];
---

<section class="section agent-section" aria-labelledby="agent-title"><div class="shell">
  <div class="section-heading section-heading--split"><div><p class="section-label"><span class="lang-id">Eksplorasi berbatas</span><span class="lang-en">Bounded assistance</span></p><h2 id="agent-title"><span class="lang-id">Agen menelusuri.<br />Manusia memutuskan.</span><span class="lang-en">Agents explore.<br />Humans decide.</span></h2></div><p><span class="lang-id">Agen HAWK-EYE dapat membuka bukti publik tersembunyi secara aman, tetapi tidak membuat kesimpulan atribusi. Setiap aksi dibatasi, dicatat, dan dapat ditinjau.</span><span class="lang-en">HAWK-EYE agents can reveal safe hidden evidence, but they do not make attribution conclusions. Every action is constrained, recorded, and reviewable.</span></p></div>
  <AgentBrowserDemo client:visible />
  <ol class="agent-flow">{steps.map(([id, en], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><strong class="lang-id">{id}</strong><strong class="lang-en">{en}</strong>{index < steps.length - 1 && <i aria-hidden="true"><ArrowRightIcon /></i>}</li>)}</ol>
  <div class="agent-rules"><article class="rule-card rule-card--allowed"><span class="rule-card__icon"><CheckIcon aria-hidden="true" /></span><div><p class="section-label"><span class="lang-id">Agen boleh</span><span class="lang-en">Agents may</span></p><h3><span class="lang-id">Membuka bukti publik yang dapat diamati.</span><span class="lang-en">Reveal observable public evidence.</span></h3></div><ul><li><span class="lang-id">Memeriksa konten terlihat</span><span class="lang-en">Inspect visible content</span></li><li><span class="lang-id">Membuka rute publik yang aman</span><span class="lang-en">Open safe public routes</span></li><li><span class="lang-id">Membuka menu dan tab</span><span class="lang-en">Reveal menus and tabs</span></li><li><span class="lang-id">Merekam bukti</span><span class="lang-en">Record evidence</span></li></ul></article><article class="rule-card rule-card--blocked"><span class="rule-card__icon"><XIcon aria-hidden="true" /></span><div><p class="section-label"><span class="lang-id">Agen dilarang</span><span class="lang-en">Agents may not</span></p><h3><span class="lang-id">Melewati batas keselamatan.</span><span class="lang-en">Cross a safety boundary.</span></h3></div><ul><li><span class="lang-id">Login atau mengirim formulir</span><span class="lang-en">Log in or submit forms</span></li><li><span class="lang-id">Mengunduh file</span><span class="lang-en">Download files</span></li><li><span class="lang-id">Menerobos pembatasan</span><span class="lang-en">Bypass restrictions</span></li><li><span class="lang-id">Membuat klaim atribusi</span><span class="lang-en">Make attribution claims</span></li></ul></article></div>
</div></section>
