---
import { CheckIcon, XIcon } from "@phosphor-icons/react";
import { AgentBrowserDemo } from "./AgentBrowserDemo";

const allowed = [
  ["Membaca konten yang terlihat", "Read visible content"],
  ["Membuka rute publik yang aman", "Open safe public routes"],
  ["Membuka menu, tab, dan tautan", "Open menus, tabs, and links"],
  ["Mencatat observasi baru", "Record new observations"],
];
const blocked = [
  ["Login atau mengirim formulir", "Log in or submit forms"],
  ["Mengunduh file", "Download files"],
  ["Melewati CAPTCHA atau pembatasan", "Bypass CAPTCHA or restrictions"],
  ["Mengakses shell atau filesystem", "Access a shell or filesystem"],
];
---

<section class="border-y border-border bg-[color-mix(in_srgb,var(--hk-panel)_56%,transparent)] py-20 sm:py-28" aria-labelledby="agent-title">
  <div class="mx-auto w-full max-w-[90rem] px-5 sm:px-8">
    <div class="mb-10 grid gap-5 lg:grid-cols-[minmax(0,0.8fr)_minmax(25rem,0.55fr)] lg:items-end">
      <h2 id="agent-title" class="text-4xl font-semibold tracking-[-0.035em] text-foreground sm:text-5xl">
        <span class="lang-id">Model membantu memilih langkah penelusuran</span>
        <span class="lang-en">The model helps choose an investigation step</span>
      </h2>
      <p class="max-w-2xl text-base leading-7 text-muted-foreground lg:justify-self-end">
        <span class="lang-id">Model hanya memilih aksi dari opsi yang diterbitkan server. Browser tetap dikendalikan sistem, setiap aksi dicatat, dan deterministic fallback tetap tersedia.</span>
        <span class="lang-en">The model only selects from server-issued actions. The system retains browser control, records every action, and keeps a deterministic fallback available.</span>
      </p>
    </div>

    <AgentBrowserDemo client:visible />

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <article class="rounded-xl border border-teal-400/25 bg-teal-400/5 p-6">
        <div class="mb-5 flex items-center gap-3">
          <span class="flex size-9 items-center justify-center rounded-full bg-teal-400/10 text-teal-300"><CheckIcon aria-hidden="true" /></span>
          <h3 class="text-lg font-semibold text-foreground"><span class="lang-id">Aksi yang tersedia</span><span class="lang-en">Available actions</span></h3>
        </div>
        <ul class="grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">
          {allowed.map(([id, en]) => <li class="flex gap-2"><CheckIcon className="mt-0.5 shrink-0 text-teal-300" aria-hidden="true" /><span class="lang-id">{id}</span><span class="lang-en">{en}</span></li>)}
        </ul>
      </article>
      <article class="rounded-xl border border-[var(--hk-pink)]/25 bg-[var(--hk-pink)]/5 p-6">
        <div class="mb-5 flex items-center gap-3">
          <span class="flex size-9 items-center justify-center rounded-full bg-[var(--hk-pink)]/10 text-[var(--hk-pink)]"><XIcon aria-hidden="true" /></span>
          <h3 class="text-lg font-semibold text-foreground"><span class="lang-id">Aksi yang tidak diterbitkan</span><span class="lang-en">Actions never issued</span></h3>
        </div>
        <ul class="grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">
          {blocked.map(([id, en]) => <li class="flex gap-2"><XIcon className="mt-0.5 shrink-0 text-[var(--hk-pink)]" aria-hidden="true" /><span class="lang-id">{id}</span><span class="lang-en">{en}</span></li>)}
        </ul>
      </article>
    </div>
  </div>
</section>
