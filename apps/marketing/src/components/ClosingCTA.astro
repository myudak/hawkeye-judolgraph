---
import type { WindowsRelease } from "../lib/release";
import { DownloadMenu } from "./DownloadMenu";
interface Props { demoUrl: string; release: WindowsRelease }
const { demoUrl, release } = Astro.props;
---

<section class="mx-auto w-full max-w-[90rem] px-5 pb-20 sm:px-8 sm:pb-28">
  <div class="grid gap-7 overflow-hidden rounded-2xl border border-[var(--hk-pink)]/35 bg-[radial-gradient(circle_at_0_100%,color-mix(in_srgb,var(--hk-pink)_16%,transparent),transparent_32rem),var(--card)] p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
    <div><h2 class="text-3xl font-semibold tracking-[-0.035em] text-foreground sm:text-4xl"><span class="lang-id">Mulai dari satu URL publik.</span><span class="lang-en">Start with one public URL.</span></h2><p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground"><span class="lang-id">Coba alur produk melalui demo atau jalankan HAWK-EYE secara lokal di Windows.</span><span class="lang-en">Try the product flow in the demo or run HAWK-EYE locally on Windows.</span></p></div>
    <div class="flex flex-wrap items-center gap-3"><a class="inline-flex min-h-11 items-center justify-center rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-[0_12px_30px_rgb(237_23_100/0.18)] hover:bg-primary/85" href={demoUrl} target="_blank" rel="noreferrer"><span class="lang-id">Buka HAWK-EYE di browser</span><span class="lang-en">Open HAWK-EYE in your browser</span></a><DownloadMenu release={release} client:visible /></div>
  </div>
</section>
