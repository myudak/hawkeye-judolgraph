---
import { ArrowsLeftRightIcon, GlobeIcon } from "@phosphor-icons/react";

const metrics = [
  ["Kontak", "Contacts", "+63 915…0101", "Cocok", "Match"],
  ["Teks", "Text", "4 fragmen", "Mirip", "Similar"],
  ["Struktur", "Structure", "Navigasi dan footer", "Mirip", "Similar"],
  ["Aset", "Assets", "3 visual", "Perlu ditinjau", "Needs review"],
];
---

<section id="compare" class="mx-auto w-full max-w-[90rem] px-5 py-20 sm:px-8 sm:py-28" aria-labelledby="compare-title">
  <div class="mb-10 grid gap-5 lg:grid-cols-[minmax(0,0.8fr)_minmax(25rem,0.55fr)] lg:items-end">
    <h2 id="compare-title" class="text-4xl font-semibold tracking-[-0.035em] text-foreground sm:text-5xl">
      <span class="lang-id">Bandingkan temuan antarsitus</span>
      <span class="lang-en">Compare findings across sites</span>
    </h2>
    <p class="max-w-2xl text-base leading-7 text-muted-foreground lg:justify-self-end">
      <span class="lang-id">HAWK-EYE membandingkan kontak, teks, struktur halaman, screenshot, dan aset. Hasilnya menjadi kandidat hubungan yang perlu diperiksa pengguna.</span>
      <span class="lang-en">HAWK-EYE compares contacts, text, page structure, screenshots, and assets. The result remains a candidate relationship for user review.</span>
    </p>
  </div>

  <div class="overflow-hidden rounded-2xl border border-border bg-card/75">
    <header class="grid gap-5 border-b border-border p-6 md:grid-cols-[1fr_auto_1fr_auto] md:items-center">
      <div class="flex items-center gap-4"><span class="flex size-11 items-center justify-center rounded-full border border-[var(--hk-pink)]/40 text-[var(--hk-pink)]"><GlobeIcon aria-hidden="true" /></span><div><small class="text-xs text-muted-foreground"><span class="lang-id">Domain sumber</span><span class="lang-en">Source domain</span></small><strong class="block font-mono text-base">qq101uok.com</strong></div></div>
      <ArrowsLeftRightIcon className="text-muted-foreground" aria-hidden="true" />
      <div class="flex items-center gap-4"><span class="flex size-11 items-center justify-center rounded-full border border-violet-400/40 text-violet-300"><GlobeIcon aria-hidden="true" /></span><div><small class="text-xs text-muted-foreground"><span class="lang-id">Domain kandidat</span><span class="lang-en">Candidate domain</span></small><strong class="block font-mono text-base">qq101uok.net</strong></div></div>
      <span class="w-fit rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-medium text-amber-300"><span class="lang-id">Perlu ditinjau</span><span class="lang-en">Needs review</span></span>
    </header>
    <div class="grid sm:grid-cols-2 xl:grid-cols-4">
      {metrics.map(([idName, enName, value, idState, enState]) => <div class="border-b border-border p-6 sm:border-r xl:border-b-0 xl:last:border-r-0"><span class="text-xs text-muted-foreground"><span class="lang-id">{idName}</span><span class="lang-en">{enName}</span></span><strong class="my-2 block text-base text-foreground">{value}</strong><small class="text-xs text-teal-300"><span class="lang-id">{idState}</span><span class="lang-en">{enState}</span></small></div>)}
    </div>
    <p class="border-t border-border px-6 py-4 text-sm leading-6 text-muted-foreground">
      <span class="lang-id">Hubungan pada graph merupakan temuan untuk ditinjau, bukan pernyataan kepemilikan atau identitas operator.</span>
      <span class="lang-en">Graph relationships are findings for review, not statements of ownership or operator identity.</span>
    </p>
  </div>
</section>
