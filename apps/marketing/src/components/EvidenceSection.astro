---
import { ArtifactGallery } from "./ArtifactGallery";
import screenshotImage from "../assets/policy-block.png";
---

<section id="evidence" class="mx-auto w-full max-w-[90rem] px-5 py-20 sm:px-8 sm:py-28" aria-labelledby="evidence-title">
  <div class="mb-10 grid gap-5 lg:grid-cols-[minmax(0,0.8fr)_minmax(25rem,0.55fr)] lg:items-end">
    <h2 id="evidence-title" class="text-4xl font-semibold tracking-[-0.035em] text-foreground sm:text-5xl">
      <span class="lang-id">Buka sumber setiap temuan</span>
      <span class="lang-en">Open the source of every finding</span>
    </h2>
    <p class="max-w-2xl text-base leading-7 text-muted-foreground lg:justify-self-end">
      <span class="lang-id">Pilih node atau hubungan pada graph untuk melihat halaman, tangkapan layar, HTML, metadata, hash, waktu capture, dan observasi yang mendasarinya.</span>
      <span class="lang-en">Select a graph node or relationship to inspect its page, screenshot, HTML, metadata, hash, capture time, and supporting observation.</span>
    </p>
  </div>
  <ArtifactGallery screenshot={screenshotImage.src} client:visible />
</section>
