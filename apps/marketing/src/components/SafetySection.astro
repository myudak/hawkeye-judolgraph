---
import { CheckIcon, ProhibitIcon } from "@phosphor-icons/react";

const allowed = [
  ["Halaman publik", "Public pages"],
  ["Navigasi baca-saja", "Read-only navigation"],
  ["Screenshot dan HTML", "Screenshots and HTML"],
  ["Metadata dan teks terlihat", "Metadata and visible text"],
];
const blocked = [
  ["Login dan pengiriman formulir", "Login and form submission"],
  ["Unduhan oleh model", "Model-initiated downloads"],
  ["Bypass CAPTCHA atau pembatasan", "CAPTCHA or restriction bypass"],
  ["Jaringan privat dan loopback", "Private networks and loopback"],
  ["Crawl otomatis kandidat", "Automatic candidate crawling"],
];
---

<section id="safety" class="border-y border-border bg-[color-mix(in_srgb,var(--hk-panel)_56%,transparent)] py-20 sm:py-28" aria-labelledby="safety-title">
  <div class="mx-auto w-full max-w-[90rem] px-5 sm:px-8">
    <div class="mb-10 grid gap-5 lg:grid-cols-[minmax(0,0.8fr)_minmax(25rem,0.55fr)] lg:items-end">
      <h2 id="safety-title" class="text-4xl font-semibold tracking-[-0.035em] text-foreground sm:text-5xl">
        <span class="lang-id">Batas pengumpulan</span>
        <span class="lang-en">Collection limits</span>
      </h2>
      <p class="max-w-2xl text-base leading-7 text-muted-foreground lg:justify-self-end">
        <span class="lang-id">Kebijakan diperiksa sebelum navigasi dan ketika tujuan berubah. Aksi di luar lingkup dihentikan dan dicatat sebagai event.</span>
        <span class="lang-en">Policy is checked before navigation and whenever a destination changes. Out-of-scope actions are stopped and recorded as events.</span>
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <article class="rounded-2xl border border-teal-400/25 bg-card/75 p-6 sm:p-8">
        <div class="mb-6 flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-full bg-teal-400/10 text-teal-300"><CheckIcon aria-hidden="true" /></span><h3 class="text-xl font-semibold"><span class="lang-id">Dikumpulkan</span><span class="lang-en">Collected</span></h3></div>
        <ul class="grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">{allowed.map(([id, en]) => <li class="flex gap-2"><CheckIcon className="mt-0.5 shrink-0 text-teal-300" aria-hidden="true" /><span class="lang-id">{id}</span><span class="lang-en">{en}</span></li>)}</ul>
      </article>
      <article class="rounded-2xl border border-[var(--hk-pink)]/25 bg-card/75 p-6 sm:p-8">
        <div class="mb-6 flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-full bg-[var(--hk-pink)]/10 text-[var(--hk-pink)]"><ProhibitIcon aria-hidden="true" /></span><h3 class="text-xl font-semibold"><span class="lang-id">Tidak dilakukan</span><span class="lang-en">Not performed</span></h3></div>
        <ul class="grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">{blocked.map(([id, en]) => <li class="flex gap-2"><ProhibitIcon className="mt-0.5 shrink-0 text-[var(--hk-pink)]" aria-hidden="true" /><span class="lang-id">{id}</span><span class="lang-en">{en}</span></li>)}</ul>
      </article>
    </div>
    <p class="mt-6 rounded-xl border border-amber-400/25 bg-amber-400/5 px-5 py-4 text-sm leading-6 text-amber-100">
      <span class="lang-id">Hubungan pada graph merupakan temuan untuk ditinjau, bukan pernyataan kepemilikan atau identitas operator.</span>
      <span class="lang-en">Graph relationships are findings for review, not statements of ownership or operator identity.</span>
    </p>
  </div>
</section>
