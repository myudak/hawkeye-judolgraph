---
import { CheckIcon, ShieldWarningIcon } from "@phosphor-icons/react";
const policies = [
  ["Perlindungan IP privat", "Private IP protection", "Loopback dan rentang privat ditolak sebelum pengumpulan.", "Loopback and private ranges are rejected before collection."],
  ["Batas permintaan", "Request budgets", "Batas waktu, halaman, dan interaksi selalu eksplisit.", "Time, page, and interaction limits stay explicit."],
  ["Validasi ulang DNS", "DNS revalidation", "Tujuan diperiksa kembali sebelum browser membukanya.", "Destinations are checked again before browser use."],
  ["Kandidat tidak dirayapi otomatis", "No automated candidate crawling", "Kandidat menunggu keputusan manusia yang tercatat.", "Candidates wait for a recorded human decision."],
  ["Tanpa interaksi login", "No login interaction", "Hanya interaksi publik dan baca-saja.", "Public, read-only interaction only."],
];
---

<section id="safety" class="section shell safety-section" aria-labelledby="safety-title"><div class="safety-copy"><p class="section-label"><span class="lang-id">Batas aman di setiap langkah</span><span class="lang-en">Guardrails at every step</span></p><h2 id="safety-title"><span class="lang-id">Keamanan adalah bagian dari model investigasi.</span><span class="lang-en">Safety is part of the investigation model.</span></h2><p><span class="lang-id">Kebijakan diperiksa sebelum navigasi dan ketika tujuan berubah. Aksi yang diblokir menjadi event yang dapat diaudit—bukan kegagalan diam-diam.</span><span class="lang-en">Policy is evaluated before navigation and again when a destination changes. A blocked action becomes an auditable event—not a silent failure.</span></p><div class="policy-block"><header><span><span class="lang-id">Aksi diblokir</span><span class="lang-en">Blocked action</span></span><strong><span class="lang-id">Event kebijakan</span><span class="lang-en">Policy event</span> · #0048</strong></header><div class="policy-block__body"><span class="shield-mark"><ShieldWarningIcon aria-hidden="true" /></span><div><h3><span class="lang-id">Navigasi eksternal tidak aman</span><span class="lang-en">Unsafe external navigation</span></h3><p><span class="lang-id">Domain kandidat memerlukan persetujuan manusia</span><span class="lang-en">Candidate domain requires human approval</span></p></div></div><footer><span><span class="lang-id">Aksi dicegah</span><span class="lang-en">Action prevented</span></span><code>safe_navigation_required</code></footer></div></div><div class="policy-list">{policies.map(([idTitle, enTitle, idCopy, enCopy], index) => <article><span>{String(index + 1).padStart(2, "0")}</span><i><CheckIcon aria-hidden="true" /></i><h3><span class="lang-id">{idTitle}</span><span class="lang-en">{enTitle}</span></h3><p><span class="lang-id">{idCopy}</span><span class="lang-en">{enCopy}</span></p></article>)}</div></section>
