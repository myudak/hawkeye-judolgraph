---
import { Logo } from "@hawkeye/brand";
import avatar from "../assets/hawkeye-avatar.png";
interface Props { repositoryUrl: string }
const { repositoryUrl } = Astro.props;
const columns = [
  { title: ["Platform", "Platform"], links: [["Alur bukti", "Evidence workflow", "#evidence"], ["Graph investigasi", "Investigation graph", "#platform"], ["Sistem replay", "Replay system", "#how-it-works"]] },
  { title: ["Sumber daya", "Resources"], links: [["Dokumentasi", "Documentation", `${repositoryUrl}/tree/main/docs`], ["Protokol evaluasi", "Evaluation protocol", `${repositoryUrl}/blob/main/docs/EVALUATION.md`], ["Model ancaman", "Threat model", `${repositoryUrl}/blob/main/docs/THREAT_MODEL.md`], ["GitHub", "GitHub", repositoryUrl]] },
  { title: ["Proyek", "Project"], links: [["Lisensi", "License", `${repositoryUrl}/blob/main/LICENSE`], ["Roadmap", "Roadmap", `${repositoryUrl}/blob/main/docs/ROADMAP.md`], ["Status", "Status", `${repositoryUrl}/blob/main/docs/STATUS.md`], ["Kontribusi", "Contributing", `${repositoryUrl}/blob/main/CONTRIBUTING.md`]] },
];
---

<footer class="site-footer"><div class="shell site-footer__top"><div class="site-footer__brand"><Logo imageSrc={avatar.src} /><p><span class="lang-id">Investigasi web publik berbasis bukti dengan provenance, netralitas, dan tinjauan yang dapat dijelaskan.</span><span class="lang-en">Evidence-driven public web investigation with provenance, neutrality, and explainable review.</span></p></div>{columns.map((column) => <nav aria-label={column.title[0]}><strong><span class="lang-id">{column.title[0]}</span><span class="lang-en">{column.title[1]}</span></strong>{column.links.map(([idLabel, enLabel, href]) => <a href={href}><span class="lang-id">{idLabel}</span><span class="lang-en">{enLabel}</span></a>)}</nav>)}</div><div class="shell site-footer__bottom"><span>© 2026 HAWK-EYE</span><span><span class="lang-id">Sumber terbuka <i>•</i> Berjalan lokal <i>•</i> Berbasis bukti</span><span class="lang-en">Open source <i>•</i> Local-first <i>•</i> Evidence-driven</span></span></div></footer>
