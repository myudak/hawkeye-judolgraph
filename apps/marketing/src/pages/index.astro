---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import avatar from "../assets/hawkeye-avatar.png";
import overviewImage from "../assets/product-overview.png";
import workspaceImage from "../assets/workspace.png";
import timelineImage from "../assets/timeline.png";
import policyImage from "../assets/policy-block.png";

const repositoryUrl = "https://github.com/myudak/hawkeye-judolgraph";
const demoUrl = import.meta.env.PUBLIC_DEMO_URL || "https://hawkeye1.myudak.com";
const directDownloadUrl = import.meta.env.PUBLIC_WINDOWS_DOWNLOAD_URL;
const releaseUrl = directDownloadUrl || `${repositoryUrl}/releases`;
const releaseLabel = directDownloadUrl ? "Download untuk Windows" : "Lihat rilis Windows";

const title = "HAWK-EYE — Bukti publik, terhubung dan dapat ditelusuri";
const description = "HAWK-EYE mengubah URL publik menjadi paket bukti yang dapat diaudit: capture, observasi, evidence graph, replay, dan human review.";

const features = [
  {
    icon: "capture" as const,
    number: "01",
    title: "Tangkap yang benar-benar tampil",
    body: "Rendered HTML, visible text, metadata respons, checkpoint screenshot, dan full-page capture disimpan bersama konteksnya.",
  },
  {
    icon: "graph" as const,
    number: "02",
    title: "Hubungkan tanpa melompat ke kesimpulan",
    body: "Halaman, kontak, merek, transaksi, penawaran, dan tujuan eksternal dipetakan dengan relasi yang tetap netral.",
  },
  {
    icon: "timeline" as const,
    number: "03",
    title: "Putar ulang prosesnya",
    body: "Timeline merekonstruksi graph dari event yang tersimpan—bukan animasi dekoratif atau state yang dibuat ulang.",
  },
  {
    icon: "review" as const,
    number: "04",
    title: "Tahan kandidat untuk ditinjau",
    body: "Lead baru tetap pending sampai investigator membaca provenance dan mencatat keputusan review.",
  },
];

const workflow = [
  ["01", "Seed", "Masukkan URL publik sebagai titik awal investigasi."],
  ["02", "Capture", "Browser terisolasi mengumpulkan halaman dalam batas waktu dan kedalaman."],
  ["03", "Extract", "Aturan deterministik membentuk observasi yang menunjuk kembali ke artefak."],
  ["04", "Connect", "Event direduksi menjadi evidence graph dan timeline yang konsisten."],
  ["05", "Review", "Investigator memeriksa kandidat dan mengekspor paket kasus."],
];

const showcases = [
  {
    id: "graph",
    label: "Evidence graph",
    eyebrow: "RELATIONSHIP VIEW",
    title: "Lihat hubungan. Lalu periksa mengapa hubungan itu ada.",
    body: "Setiap node mengarah ke inspector yang menjelaskan sumber halaman, artifact ID, metode ekstraksi, waktu observasi, dan keterbatasannya.",
    image: workspaceImage,
    alt: "HAWK-EYE evidence graph workspace dengan ringkasan kasus dan panel bukti",
  },
  {
    id: "replay",
    label: "Replay",
    eyebrow: "EVENT-SOURCED REPLAY",
    title: "Investigasi yang bisa direkonstruksi, bukan sekadar dipresentasikan.",
    body: "Replay membaca urutan event persisten. Reload membangun kembali graph truth yang sama, sementara kecepatan animasi tetap hanya lapisan presentasi.",
    image: timelineImage,
    alt: "HAWK-EYE timeline replay yang menunjukkan perubahan evidence graph",
  },
  {
    id: "policy",
    label: "Safety policy",
    eyebrow: "BOUNDED BY DESIGN",
    title: "Otomasi berhenti ketika tindakan tidak aman.",
    body: "Login, registrasi, form submission, download, dan tujuan yang tidak aman diblokir di server. Model tidak pernah mendapat browser atau shell tanpa batas.",
    image: policyImage,
    alt: "HAWK-EYE menampilkan tindakan yang diblokir oleh safety policy",
  },
];
---

<BaseLayout title={title} description={description}>
  <div id="top" class="page-frame">
    <SiteHeader {demoUrl} />

    <main id="main-content">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero__copy" data-reveal>
          <div class="eyebrow"><span></span> Public evidence, reconstructed</div>
          <h1 id="hero-title">Jejak web berubah. <em>Buktinya tidak boleh.</em></h1>
          <p class="hero__lead">
            HAWK-EYE mengubah satu URL publik menjadi capture yang terverifikasi, observasi yang
            transparan, dan graph yang bisa diputar ulang.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href={releaseUrl} target="_blank" rel="noreferrer">
              <Icon name="download" />
              {releaseLabel}
            </a>
            <a class="button button--ghost" href={demoUrl} target="_blank" rel="noreferrer">
              Coba demo web
              <Icon name="arrow" />
            </a>
          </div>
          <p class="hero__micro">Local-first · Windows 10/11 · deterministic fallback tersedia</p>
        </div>

        <div class="hero__visual" data-reveal data-delay="1">
          <div class="radar" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="product-window">
            <div class="product-window__bar">
              <span class="window-dots"><i></i><i></i><i></i></span>
              <span>HAWK-EYE · INVESTIGATION WORKSPACE</span>
              <span class="window-live"><i></i> EVIDENCE READY</span>
            </div>
            <img src={overviewImage.src} width={overviewImage.width} height={overviewImage.height} alt="Kolase antarmuka HAWK-EYE yang menampilkan landing, graph, dan progressive capture" />
          </div>
          <div class="floating-proof floating-proof--left">
            <Icon name="shield" size={18} />
            <span><strong>SHA-256</strong> manifest verified</span>
          </div>
          <div class="floating-proof floating-proof--right">
            <Icon name="timeline" size={18} />
            <span><strong>Append-only</strong> event trail</span>
          </div>
        </div>
      </section>

      <section class="trust-rail" aria-label="Prinsip utama HAWK-EYE">
        <div class="shell trust-rail__inner">
          <p><span>01</span> Artefak terverifikasi sebelum ditampilkan</p>
          <p><span>02</span> Observasi selalu menunjuk ke sumber</p>
          <p><span>03</span> Kandidat tidak pernah menjadi tuduhan</p>
        </div>
      </section>

      <section id="produk" class="manifesto section shell">
        <div class="section-index">01 / WHY</div>
        <div class="manifesto__headline" data-reveal>
          <p class="eyebrow"><span></span> Bukan crawler biasa</p>
          <h2>Screenshot memberi gambar. HAWK-EYE memberi <em>rantai bukti.</em></h2>
        </div>
        <div class="manifesto__body" data-reveal data-delay="1">
          <p>
            Investigasi web sering berakhir sebagai folder screenshot, catatan manual, dan klaim
            yang sulit direproduksi. HAWK-EYE mempertahankan hubungan antara apa yang terlihat,
            kapan dikumpulkan, bagaimana diekstrak, dan mengapa masuk ke graph.
          </p>
          <blockquote>
            “Yang penting bukan seberapa banyak node yang dibuat—tetapi apakah setiap node dapat
            dipertanggungjawabkan.”
          </blockquote>
        </div>
      </section>

      <section class="features section shell" aria-labelledby="feature-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span></span> Evidence-first system</p>
            <h2 id="feature-title">Satu alur. Empat lapis kepercayaan.</h2>
          </div>
          <p>Capture, provenance, reconstruction, dan human judgment tetap terhubung.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature-card" data-reveal>
              <div class="feature-card__top">
                <span>{feature.number}</span>
                <Icon name={feature.icon} size={24} />
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="cara-kerja" class="workflow section">
        <div class="shell">
          <div class="section-index">02 / FLOW</div>
          <div class="workflow__intro">
            <div data-reveal>
              <p class="eyebrow"><span></span> Dari URL ke evidence package</p>
              <h2>Investigasi yang bergerak maju tanpa kehilangan jejak ke belakang.</h2>
            </div>
            <p data-reveal data-delay="1">
              Model bersifat opsional. Policy dan deterministic fallback tetap memegang kendali atas
              tindakan yang boleh dijalankan.
            </p>
          </div>
          <ol class="workflow-list">
            {workflow.map(([number, label, body]) => (
              <li data-reveal>
                <span class="workflow-list__number">{number}</span>
                <strong>{label}</strong>
                <p>{body}</p>
                <span class="workflow-list__line" aria-hidden="true"></span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="bukti" class="showcase section shell">
        <div class="section-index">03 / PRODUCT</div>
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span></span> Inspect the why</p>
            <h2>Graph adalah peta. Evidence inspector adalah alasannya.</h2>
          </div>
          <p>Semua visual di bawah berasal dari produk dan fixture evaluasi HAWK-EYE.</p>
        </div>

        <div class="showcase__tabs" role="tablist" aria-label="Tampilan produk">
          {showcases.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${item.id}`}
              aria-controls={`panel-${item.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-showcase-tab={item.id}
            >
              <span>0{index + 1}</span>{item.label}
            </button>
          ))}
        </div>

        <div class="showcase__panels">
          {showcases.map((item, index) => (
            <article
              role="tabpanel"
              id={`panel-${item.id}`}
              aria-labelledby={`tab-${item.id}`}
              hidden={index !== 0}
              data-showcase-panel={item.id}
            >
              <div class="showcase__copy">
                <p class="eyebrow"><span></span>{item.eyebrow}</p>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <div class="showcase__image-wrap">
                <div class="scan-line" aria-hidden="true"></div>
                <img src={item.image.src} width={item.image.width} height={item.image.height} alt={item.alt} loading="lazy" />
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="boundary section shell" aria-labelledby="boundary-title">
        <div class="boundary__seal" aria-hidden="true">
          <img src={avatar.src} width="112" height="112" alt="" />
          <span>READ ONLY</span>
        </div>
        <div class="boundary__copy">
          <p class="eyebrow"><span></span> Safety is a product feature</p>
          <h2 id="boundary-title">Kemampuan yang dibatasi dengan sengaja.</h2>
          <p>
            HAWK-EYE hanya mengumpulkan konten publik dan read-only. Sistem tidak login, mengirim
            formulir, melakukan transaksi, menyelesaikan CAPTCHA, atau otomatis merayapi kandidat.
          </p>
        </div>
        <ul class="boundary__list">
          <li><Icon name="shield" size={18} /> Public HTTP(S) only</li>
          <li><Icon name="shield" size={18} /> Bounded page and time budget</li>
          <li><Icon name="shield" size={18} /> Server-issued safe references</li>
          <li><Icon name="shield" size={18} /> Human review for candidate leads</li>
        </ul>
      </section>

      <section id="download" class="download section">
        <div class="shell download__grid">
          <div class="download__copy" data-reveal>
            <p class="eyebrow"><span></span> Choose your path</p>
            <h2>Gunakan lokal. Atau lihat alurnya langsung di web.</h2>
            <p>
              Installer Windows menjalankan workspace pada mesin sendiri. Demo web memberi evaluator
              cara tercepat untuk memahami alur tanpa setup development.
            </p>
          </div>
          <div class="release-card release-card--primary" data-reveal data-delay="1">
            <span class="release-card__tag">WINDOWS · X64</span>
            <h3>HAWK-EYE Desktop</h3>
            <p>Backend, frontend, dan browser runtime dibungkus sebagai instalasi lokal.</p>
            <a class="button button--light" href={releaseUrl} target="_blank" rel="noreferrer">
              <Icon name="download" />{releaseLabel}
            </a>
            <small>Rilis dan checksum dipublikasikan melalui GitHub Releases.</small>
          </div>
          <div class="release-card" data-reveal data-delay="2">
            <span class="release-card__tag">ONLINE PREVIEW</span>
            <h3>Demo web</h3>
            <p>Jalankan walkthrough publik tanpa memasang toolchain pengembangan.</p>
            <a class="button button--ghost" href={demoUrl} target="_blank" rel="noreferrer">
              Buka demo <Icon name="external" />
            </a>
            <small>Demo bersifat sementara dan bukan deployment multi-user.</small>
          </div>
        </div>
      </section>

      <section class="open-source shell section">
        <div>
          <p class="eyebrow"><span></span> Built in the open</p>
          <h2>Arsitektur dan batasannya dapat diperiksa.</h2>
        </div>
        <p>
          Monorepo menggabungkan FastAPI, React, Playwright, append-only SQLite, controlled fixtures,
          dan workflow build yang dapat direproduksi.
        </p>
        <a class="button button--ghost" href={repositoryUrl} target="_blank" rel="noreferrer">
          <Icon name="github" /> Lihat source code
        </a>
      </section>
    </main>

    <SiteFooter {demoUrl} {repositoryUrl} />
  </div>

  <script>
    const revealElements = document.querySelectorAll<HTMLElement>("[data-reveal]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion) {
      revealElements.forEach((element) => element.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      revealElements.forEach((element) => observer.observe(element));
    }

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-showcase-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-showcase-panel]"));

    const selectShowcase = (id: string) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.showcaseTab === id;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.showcasePanel !== id;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectShowcase(tab.dataset.showcaseTab || "graph"));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(index + direction + tabs.length) % tabs.length];
        next.focus();
        selectShowcase(next.dataset.showcaseTab || "graph");
      });
    });

    const header = document.querySelector<HTMLElement>("[data-header]");
    const setHeaderState = () => header?.classList.toggle("is-scrolled", window.scrollY > 16);
    setHeaderState();
    window.addEventListener("scroll", setHeaderState, { passive: true });
  </script>
</BaseLayout>
